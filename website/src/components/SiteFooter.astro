---
import { localeOf, localePath, t } from '../i18n/ui';
import { CHANGELOG_URL, RELEASES_URL, REPOSITORY_URL } from '../lib/release';

const locale = localeOf(Astro.url);
---

<footer class="gut">
  <div class="wrap foot">
    <span class="brand">
      <img src="/favicon.svg" alt="" width="24" height="24" />
      yaggui
    </span>
    <nav aria-label={t(locale, 'nav.footer')}>
      <a href={localePath(locale, '/docs/')}>{t(locale, 'nav.docs')}</a>
      <a href={CHANGELOG_URL}>{t(locale, 'nav.changelog')}</a>
      <a href={RELEASES_URL}>{t(locale, 'nav.releases')}</a>
      <a href={REPOSITORY_URL}>GitHub</a>
    </nav>
    <span class="r">{t(locale, 'footer.license')}</span>
  </div>
</footer>
