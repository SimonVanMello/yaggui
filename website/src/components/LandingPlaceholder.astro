---
// Placeholder landing page (W-1): the real page, from the mockup, is W-2's.
import graphDark from '../../../docs/assets/screenshot-graph.png';
import graphLight from '../../../docs/assets/screenshot-graph-paper.png';
import DownloadButton from './DownloadButton.astro';
import Screenshot from './Screenshot.astro';
import { localeOf, localePath, t } from '../i18n/ui';

const locale = localeOf(Astro.url);
---

<section class="gut">
  <div class="wrap hero">
    <h1>{t(locale, 'placeholder.title')}</h1>
    <p class="lead">{t(locale, 'placeholder.lead')}</p>
    <div class="ctas">
      <DownloadButton />
      <a class="btn ghost" href={localePath(locale, '/docs/')}>
        {t(locale, 'placeholder.docs')}
      </a>
    </div>
  </div>
</section>
<section class="gut">
  <div class="wrap shot">
    <Screenshot dark={graphDark} light={graphLight} alt="yaggui commit graph" eager />
  </div>
</section>

<style>
  .hero {
    text-align: center;
    padding-block: 112px 56px;
  }
  .hero h1 {
    margin: 0 auto;
    font-size: clamp(42px, 6.6vw, 76px);
    line-height: 1.04;
    letter-spacing: -0.045em;
    max-width: 13ch;
  }
  .lead {
    margin: 22px auto 0;
    max-width: 34em;
    font-size: 18.5px;
    color: var(--fg2);
  }
  .ctas {
    margin-top: 34px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    justify-content: center;
  }
  .shot {
    padding-bottom: 96px;
  }
  @media (max-width: 640px) {
    .hero {
      padding-block: 64px 40px;
    }
  }
</style>
