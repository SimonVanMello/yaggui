---
import DownloadButton from './DownloadButton.astro';
import { alternatePath, localeOf, localePath, t } from '../i18n/ui';
import { CHANGELOG_URL, REPOSITORY_URL } from '../lib/release';

const locale = localeOf(Astro.url);
---

<div class="nav-wrap gut">
  <nav class="nav wrap" aria-label={t(locale, 'nav.main')}>
    <a class="brand" href={localePath(locale, '/')} aria-label={t(locale, 'nav.home')}>
      <img src="/favicon.svg" alt="" width="24" height="24" />
      yaggui
    </a>
    <div class="nav-links">
      <a href={localePath(locale, '/#features')}>{t(locale, 'nav.features')}</a>
      <a href={localePath(locale, '/docs/')}>{t(locale, 'nav.docs')}</a>
      <a href={localePath(locale, '/#faq')}>{t(locale, 'nav.faq')}</a>
      <a href={CHANGELOG_URL}>{t(locale, 'nav.changelog')}</a>
    </div>
    <a class="nav-icon github" href={REPOSITORY_URL}>
      <svg viewBox="0 0 16 16" aria-hidden="true">
        <path
          fill="currentColor"
          d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"
        ></path>
      </svg>
      GitHub
    </a>
    <a
      class="nav-icon"
      href={alternatePath(Astro.url)}
      hreflang={locale === 'en' ? 'fr' : 'en'}
      lang={locale === 'en' ? 'fr' : 'en'}
      aria-label={t(locale, 'nav.languageLabel')}
    >
      {locale === 'en' ? 'FR' : 'EN'}
    </a>
    <button
      type="button"
      class="nav-icon yaggui-theme-toggle"
      aria-label={t(locale, 'theme.toggle')}
    >
      <svg viewBox="0 0 16 16" aria-hidden="true">
        <circle cx="8" cy="8" r="6" fill="none" stroke="currentColor" stroke-width="1.4"></circle>
        <path d="M8 2a6 6 0 0 1 0 12z" fill="currentColor"></path>
      </svg>
    </button>
    <DownloadButton size="sm" />
  </nav>
</div>

<script>
  // Same storage as Starlight's theme select: `dark`, `light`, or empty for the OS theme.
  for (const button of document.querySelectorAll('.yaggui-theme-toggle')) {
    button.addEventListener('click', () => {
      const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
      document.documentElement.dataset.theme = next;
      try {
        localStorage.setItem('starlight-theme', next);
      } catch {
        // Private mode: the choice lasts for this page only.
      }
    });
  }
  matchMedia('(prefers-color-scheme: light)').addEventListener('change', (e) => {
    let stored: string | null = null;
    try {
      stored = localStorage.getItem('starlight-theme');
    } catch {
      // Same as no stored choice.
    }
    if (!stored) document.documentElement.dataset.theme = e.matches ? 'light' : 'dark';
  });
</script>
