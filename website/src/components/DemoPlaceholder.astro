---
// Placeholder of the live demo slot (W-1): W-5 serves the mocked app here.
import { localeOf, t } from '../i18n/ui';

const locale = localeOf(Astro.url);
---

<section class="gut">
  <div class="wrap demo">
    <h1>{t(locale, 'demo.title')}</h1>
    <p>{t(locale, 'demo.lead')}</p>
  </div>
</section>

<style>
  .demo {
    padding-block: 96px 128px;
    text-align: center;
  }
  h1 {
    font-size: clamp(32px, 4vw, 46px);
    letter-spacing: -0.035em;
  }
  p {
    margin-top: 16px;
    color: var(--fg2);
    font-size: 17.5px;
  }
</style>
