{
  "name": "yaggui",
  "private": true,
  "version": "0.4.0",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "vite --mode mock",
    "dev:tauri": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "check": "node scripts/check-case.mjs && pnpm lint && pnpm format:check && pnpm typecheck && pnpm test",
    "test:ui": "playwright test",
    "screenshots": "playwright test --config playwright.screenshots.config.ts",
    "perf:tabs": "playwright test --config playwright.perf.config.ts perf.spec",
    "perf:startup": "node scripts/measure-startup.mjs",
    "release:version": "node scripts/version.mjs set",
    "bindings": "cargo run --manifest-path src-tauri/Cargo.toml --example export-bindings",
    "perf:diff": "playwright test --config playwright.perf.config.ts perf-diff",
    "perf:graph": "playwright test --config playwright.perf.config.ts perf-graph",
    "perf:palette": "playwright test --config playwright.perf.config.ts perf-palette",
    "perf:status": "playwright test --config playwright.perf.config.ts perf-status",
    "perf:blame": "playwright test --config playwright.perf.config.ts perf-blame"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.8.0",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-virtual": "^3.14.16",
    "@tauri-apps/api": "^2.12.3",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "radix-ui": "^1.8.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@tauri-apps/cli": "^2.12.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
