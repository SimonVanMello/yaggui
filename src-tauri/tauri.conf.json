{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "yaggui",
  "version": "0.13.0",
  "identifier": "dev.tropico.yaggui",
  "build": {
    "beforeDevCommand": "pnpm dev:tauri",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "yaggui",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 560,
        "decorations": false,
        "visible": false,
        "backgroundColor": "#0f1115"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "yaggui contributors",
    "copyright": "Copyright © 2026 the yaggui contributors",
    "license": "GPL-3.0-or-later",
    "homepage": "https://github.com/SimonVanMello/yaggui",
    "category": "DeveloperTool",
    "shortDescription": "Fast, cross-platform graphical Git client",
    "longDescription": "yaggui is a local graphical Git client focused on ergonomics and performance: commit graph, staging, diffs, merges, rebases and stashes, on top of the git binary installed on the system.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["git"],
        "section": "vcs"
      },
      "rpm": {
        "depends": ["git"]
      }
    },
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDAyNjA2Njg1NjEzMUQ1MkUKUldRdTFURmhoV1pnQWg1V1oxMWl0a0ppeEE5YWdQUGhBNnMyTDV3WFBydFAzL041UWppWTdPSUsK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
